{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "trashit-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "trashit-dev-oauth",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "env": {
        "NEXT_PUBLIC_OAUTH_PROVIDERS": "google"
      }
    }
  ]
}
