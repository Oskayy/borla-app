generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  DRIVER
  SUPER_ADMIN
  OPS_MANAGER
  DISPATCHER
  FINANCE
  SUPPORT
  COMPLIANCE
  ANALYST
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  READY_FOR_BATCH
  ASSIGNED
  EN_ROUTE
  ARRIVED
  PICKUP_PENDING_REVIEW
  PICKED_UP
  DISPOSAL_PENDING
  DISPOSAL_VERIFIED
  COMPLETED
  FAILED_PICKUP
  DISPUTED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  email     String?  @unique
  name      String
  role      UserRole
  createdAt DateTime @default(now())

  customerProfile CustomerProfile?
  driverProfile   DriverProfile?
  ordersAsCustomer Order[] @relation("CustomerOrders")
  ordersAsDriver   Order[] @relation("DriverOrders")
}

model CustomerProfile {
  id         String @id @default(uuid())
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id])
  address    String // the customer's home address, as they typed it
  zoneId     String?
  zone       Zone?  @relation(fields: [zoneId], references: [id])
  homeLat    Float? // the pin they placed on the map
  homeLng    Float?
  homeUpdatedAt DateTime?
}

model DriverProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  vehicleType      String?   // "Borla car" | "Aboboyaa tricycle"
  vehiclePlate     String?
  isActive         Boolean   @default(true)
  zoneId           String?
  zone             Zone?     @relation(fields: [zoneId], references: [id])
  homeAddress      String?
  homeLat          Float?
  homeLng          Float?
  currentLat       Float?
  currentLng       Float?
  lastLocationAt   DateTime?
}

model Zone {
  id            String            @id @default(uuid())
  name          String
  city          String            // Accra | Kumasi | Tema
  centerLat     Float?
  centerLng     Float?
  radiusKm      Float             @default(3)
  coveredAreas  String[]          @default([])
  active        Boolean           @default(true)
  // Price multiplier for pickups in this zone. Only Super Admin / Finance may change it.
  priceMultiplier Float           @default(1.0)
  createdAt     DateTime          @default(now())
  customers     CustomerProfile[]
  orders        Order[]
  facilities    Facility[]
  drivers       DriverProfile[]
}

model Facility {
  id        String   @id @default(uuid())
  name      String
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id])
  verifications FacilityVerification[]
}

model PricingRule {
  id            String   @id @default(uuid())
  name          String
  baseFee       Float    // flat fee per order
  volumeRate    Float    // per-bin charge, added to every bin whatever its size
  zoneMultiplier Float   @default(1.0) // DEPRECATED: multipliers now live on each Zone. Kept so old rules stay readable.
  hazardSurcharge Float  @default(0)
  lateSurcharge Float    @default(0)   // added to late orders (booked after the planning snapshot)
  platformFeePercent Float @default(0) // Borla's share, taken before the driver 40/60 split
  separatedDiscountPercent Float    @default(15)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  binPrices     PricingRuleBinPrice[]
}

// Customer-facing bin sizes (e.g. small 30 L, medium 60 L, large 120 L).
model BinSize {
  id        String   @id @default(uuid())
  code      String   @unique // "small" | "medium" | "large"
  label     String
  litres    Int
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  prices    PricingRuleBinPrice[]
}

// A bin size's fee inside one pricing rule, so each rule and its bin prices are versioned together.
model PricingRuleBinPrice {
  id            String      @id @default(uuid())
  pricingRuleId String
  pricingRule   PricingRule @relation(fields: [pricingRuleId], references: [id])
  binSizeId     String
  binSize       BinSize     @relation(fields: [binSizeId], references: [id])
  fee           Float

  @@unique([pricingRuleId, binSizeId])
}

// Single row (id = 1). Times are minutes after local midnight in `timezone`.
model OperatingSettings {
  id                      Int      @id @default(1)
  timezone                String   @default("Africa/Accra")
  shiftStartMinutes       Int      @default(1200) // 20:00
  shiftEndMinutes         Int      @default(360)  // 06:00 next morning
  planningSnapshotMinutes Int      @default(1080) // 18:00
  hardCutoffMinutes       Int      @default(0)    // 00:00
  updatedAt               DateTime @updatedAt
}

model PayoutRule {
  id              String   @id @default(uuid())
  pickupPercent   Float    // e.g. 40
  disposalPercent Float    // e.g. 60
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Order {
  id          String      @id @default(uuid())
  customerId  String
  customer    User        @relation("CustomerOrders", fields: [customerId], references: [id])
  driverId    String?
  driver      User?       @relation("DriverOrders", fields: [driverId], references: [id])
  status      OrderStatus @default(DRAFT)
  zoneId      String?
  zone        Zone?       @relation(fields: [zoneId], references: [id])
  shiftDate   DateTime?   @db.Date // the night this order is collected (shift starts 20:00 on this date)
  isLateOrder Boolean     @default(false)
  latitude    Float?
  longitude   Float?
  quoteSnapshot Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt


  evidence       OrderEvidence[]
  disputes       Dispute[]
  facilityChecks FacilityVerification[]
  routeStop      RouteStop?
  auditLogs      AuditLog[]
  ledgerEntries  LedgerEntry[]
  payments       Payment[]

  @@index([shiftDate, status])
}

model OrderEvidence {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  type         String   // "customer_placement" | "driver_pickup"
  photoUrl     String
  gpsLat       Float?
  gpsLng       Float?
  gpsAccuracy  Float?
  capturedAt   DateTime
  aiAssessment Json?
  createdAt    DateTime @default(now())
}

model FacilityVerification {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id])
  method     String   // "qr" | "pin"
  verifiedAt DateTime @default(now())
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  provider      String   // "paystack" | "hubtel"
  amount        Float
  status        String   // "success" | "failed" | "refunded"
  providerRef   String   @unique
  createdAt     DateTime @default(now())
}

model LedgerEntry {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  type        String   // "customer_payment" | "driver_payout_pickup" | "driver_payout_disposal" | "refund"
  amount      Float
  idempotencyKey String @unique
  createdAt   DateTime @default(now())
}

model Dispute {
  id         String    @id @default(uuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id])
  raisedBy   String
  reason     String
  status     String    @default("OPEN")
  resolution String?
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  actorId   String?
  fromState String?
  toState   String
  reason    String?
  createdAt DateTime @default(now())
}
model Route {
  id        String      @id @default(uuid())
  driverId  String
  createdAt DateTime    @default(now())
  stops     RouteStop[]
}

model RouteStop {
  id        String   @id @default(uuid())
  routeId   String
  route     Route    @relation(fields: [routeId], references: [id])
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  sequence  Int
}

model RateLimitAttempt {
  id         String   @id @default(uuid())
  identifier String
  action     String
  success    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, action, createdAt])
}
model AdminActionLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  targetId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}