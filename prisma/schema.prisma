generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  DRIVER
  SUPER_ADMIN
  OPS_MANAGER
  DISPATCHER
  FINANCE
  SUPPORT
  COMPLIANCE
  ANALYST
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  READY_FOR_BATCH
  ASSIGNED
  EN_ROUTE
  ARRIVED
  PICKUP_PENDING_REVIEW
  PICKED_UP
  DISPOSAL_PENDING
  DISPOSAL_VERIFIED
  COMPLETED
  FAILED_PICKUP
  DISPUTED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  email     String?  @unique
  name      String
  role      UserRole
  createdAt DateTime @default(now())

  customerProfile CustomerProfile?
  driverProfile   DriverProfile?
  ordersAsCustomer Order[] @relation("CustomerOrders")
  ordersAsDriver   Order[] @relation("DriverOrders")
  orderDeclines    OrderDecline[]
  ratingsReceived  OrderRating[] @relation("DriverRatings")
  driverMisses     DriverMiss[]
  notifications    Notification[]
  pushSubscriptions PushSubscription[]
  withdrawals      Withdrawal[]
  driverDocuments  DriverDocument[]
  active             Boolean @default(true)  // false = suspended: cannot sign in or use the app
  mustChangePassword Boolean @default(false) // staff created with a temporary password
}

model CustomerProfile {
  id         String @id @default(uuid())
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id])
  address    String // the customer's home address, as they typed it
  zoneId     String?
  zone       Zone?  @relation(fields: [zoneId], references: [id])
  homeLat    Float? // the pin they placed on the map
  homeLng    Float?
  homeUpdatedAt DateTime?
  homePinConfirmedAt DateTime? // the customer confirmed the pin sits on their house or gate
}

model DriverProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  vehicleType      String?   // "Borla car" | "Aboboyaa tricycle" (display name; kept for older screens)
  vehicleTypeId    String?
  vehicleTypeRef   VehicleType? @relation(fields: [vehicleTypeId], references: [id])
  radiusKm         Float?    // how far from their position this driver will take orders
  vehiclePlate     String?
  ghanaCardNumber  String?   @unique // GHA-123456789-0; drivers type it, no photo of the card is kept
  isActive         Boolean   @default(true)
  zoneId           String?
  zone             Zone?     @relation(fields: [zoneId], references: [id])
  homeAddress      String?
  homeLat          Float?
  homeLng          Float?
  currentLat       Float?
  currentLng       Float?
  lastLocationAt   DateTime?
  isOnline         Boolean   @default(false) // driver pressed "Go online"
  wentOnlineAt     DateTime?
  onlineOverrideUntil DateTime? // ops let this driver work outside shift hours until this time
  approvalStatus   String    @default("PENDING") // PENDING | APPROVED | REJECTED
  approvalNote     String?   // why a driver was rejected, shown to them
  submittedAt      DateTime? // documents sent for review
  reviewedAt       DateTime?
  reviewedBy       String?
  momoNumber       String?   // where earnings are paid (mobile money)
  momoProvider     String?   // Paystack telco code: MTN | VOD | ATL
  momoName         String?   // name on the MoMo wallet
  paystackRecipientCode String? // Paystack transfer recipient for the number above
  recipientFor     String?   // "<provider>:<number>" the recipient code was made for
  momoChangedAt    DateTime? // when the wallet above last replaced an earlier one; withdrawals wait 24 h after
  workNights       Int[]     @default([0, 1, 2, 3, 4, 5, 6]) // nights the driver works (0 = Sunday, by the shift's start date)
  nightsOff        String[]  @default([]) // single nights off, as shift dates (YYYY-MM-DD)
  // A change of vehicle type by an approved driver waits for ops approval; until then the current vehicle is used.
  pendingVehicleTypeId String?   // the vehicle type asked for
  pendingRadiusKm      Float?    // the radius asked for with it (within the new vehicle's limit)
  pendingVehicleAt     DateTime? // when the driver sent it for approval (with a photo of the new vehicle)
  vehicleChangeNote    String?   // why ops sent the change back, shown to the driver
}

model Zone {
  id            String            @id @default(uuid())
  name          String
  city          String            // Accra | Kumasi | Tema
  centerLat     Float?
  centerLng     Float?
  radiusKm      Float             @default(3)
  coveredAreas  String[]          @default([])
  active        Boolean           @default(true)
  // Price multiplier for pickups in this zone. Only Super Admin / Finance may change it.
  priceMultiplier Float           @default(1.0)
  createdAt     DateTime          @default(now())
  customers     CustomerProfile[]
  orders        Order[]
  facilities    Facility[]
  drivers       DriverProfile[]
}

// A disposal site (landfill or transfer station) where drivers unload.
model Facility {
  id        String   @id @default(uuid())
  name      String
  zoneId    String?  // optional: a site can serve several zones
  zone      Zone?    @relation(fields: [zoneId], references: [id])
  address   String?
  lat       Float?
  lng       Float?
  geofenceRadiusM  Int      @default(150)  // disposal photos must be taken within this distance
  open24Hours      Boolean  @default(true)
  opensAtMinutes   Int?     // minutes after local midnight, e.g. 1140 = 19:00 (used when not 24 hours)
  closesAtMinutes  Int?     // may be earlier than opensAt for overnight hours
  acceptedWaste    String[] @default(["general", "recyclable"]) // general | recyclable | hazardous
  status           String   @default("OPEN") // OPEN | CLOSED | FULL, switched by ops during the shift
  avgUnloadMinutes Int      @default(15)
  tippingFee       Float    @default(0) // GHS a driver pays to tip here (recorded only; not reimbursed yet)
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  verifications FacilityVerification[]
  routeTrips    RouteTrip[]
}

model PricingRule {
  id            String   @id @default(uuid())
  name          String
  baseFee       Float    // flat fee per order
  volumeRate    Float    // per-bin charge, added to every bin whatever its size
  zoneMultiplier Float   @default(1.0) // DEPRECATED: multipliers now live on each Zone. Kept so old rules stay readable.
  hazardSurcharge Float  @default(0)
  lateSurcharge Float    @default(0)   // added to late orders (booked after the planning snapshot)
  platformFeePercent Float @default(0) // Borla's share, taken before the driver 40/60 split
  separatedDiscountPercent Float    @default(15)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  binPrices     PricingRuleBinPrice[]
}

// Customer-facing bin sizes (e.g. small 30 L, medium 60 L, large 120 L).
model BinSize {
  id        String   @id @default(uuid())
  code      String   @unique // "small" | "medium" | "large"
  label     String
  litres    Int
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  prices    PricingRuleBinPrice[]
}

// A bin size's fee inside one pricing rule, so each rule and its bin prices are versioned together.
model PricingRuleBinPrice {
  id            String      @id @default(uuid())
  pricingRuleId String
  pricingRule   PricingRule @relation(fields: [pricingRuleId], references: [id])
  binSizeId     String
  binSize       BinSize     @relation(fields: [binSizeId], references: [id])
  fee           Float

  @@unique([pricingRuleId, binSizeId])
}

// Single row (id = 1). Times are minutes after local midnight in `timezone`.
model OperatingSettings {
  id                      Int      @id @default(1)
  timezone                String   @default("Africa/Accra")
  shiftStartMinutes       Int      @default(1200) // 20:00
  shiftEndMinutes         Int      @default(360)  // 06:00 next morning
  planningSnapshotMinutes Int      @default(1080) // 18:00
  hardCutoffMinutes       Int      @default(0)    // 00:00
  maxTripsPerNight        Int      @default(3)    // round trips (collect -> unload) one driver can do in a shift
  acceptMinutes           Int      @default(15)   // time a driver has to accept a stop before it goes to another driver
  autoDispatch            Boolean  @default(true) // from shift start, assign waiting orders to the best drivers automatically
  acceptHazardous         Boolean  @default(false) // customers can book hazardous waste (needs a site that takes it); planned by hand
  paystackTransfers       Boolean  @default(false) // Paystack can send driver payouts (needs a Registered Business account); off = Finance pays by hand
  // Tax (lib/tax.ts): every rate 0 until the accountant confirms them.
  vatPercent              Float    @default(0)
  nhilPercent             Float    @default(0)
  getfundPercent          Float    @default(0)
  withholdingPercent      Float    @default(0) // withheld from driver payouts
  updatedAt               DateTime @updatedAt
}

model PayoutRule {
  id              String   @id @default(uuid())
  pickupPercent   Float    // e.g. 40
  disposalPercent Float    // e.g. 60
  // Step 7 (lib/money-split.ts): how surcharges and the recyclable discount are shared, and the distance bonus.
  lateSurchargeDriverPercent        Float @default(100) // share of the late-order surcharge that goes to drivers
  hazardSurchargeDriverPercent      Float @default(100) // share of the hazardous surcharge that goes to drivers
  recyclableDiscountPlatformPercent Float @default(100) // share of the recyclable discount Trashit's fee absorbs
  distanceFreeKm                    Float @default(3)   // no bonus within this distance of the driver's home base
  distanceBonusPerKm                Float @default(1)   // GHS per km beyond it (0 = no bonus)
  distanceBonusCap                  Float @default(10)  // GHS, most a stop can earn
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Order {
  id          String      @id @default(uuid())
  customerId  String
  customer    User        @relation("CustomerOrders", fields: [customerId], references: [id])
  driverId    String?
  driver      User?       @relation("DriverOrders", fields: [driverId], references: [id])
  status      OrderStatus @default(DRAFT)
  zoneId      String?
  zone        Zone?       @relation(fields: [zoneId], references: [id])
  shiftDate   DateTime?   @db.Date // the night this order is collected (shift starts 20:00 on this date)
  isLateOrder Boolean     @default(false)
  rolloverCount Int       @default(0) // nights this order was moved on because it wasn't collected
  assignedNoticeAt DateTime? // customer was told a driver is assigned (cleared on rollover)
  cancelledAt   DateTime?
  cancelReason  String?
  // The price split, worked out once when payment is confirmed (lib/money-split.ts), in whole pesewas and
  // basis points. Later rule changes only affect new orders. Null on orders paid before this existed
  // (worked out at their first payout instead).
  pricePesewas       Int?
  platformFeePesewas Int?
  pickupSharePesewas Int?
  unloadSharePesewas Int?
  feeBps             Int?
  pickupBps          Int?
  splitFrozenAt      DateTime?
  distanceBonusPesewas  Int?    // fixed when the order is assigned, for that driver; paid with the unload share
  distanceBonusDriverId String?
  latitude    Float?
  longitude   Float?
  driverAcceptedAt DateTime? // the assigned driver accepted this stop (cleared on reassignment)
  offeredAt        DateTime? // when the stop was given to the current driver (the accept clock starts here, or at shift start)
  quoteSnapshot Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt


  evidence       OrderEvidence[]
  disputes       Dispute[]
  facilityChecks FacilityVerification[]
  routeStop      RouteStop?
  auditLogs      AuditLog[]
  ledgerEntries  LedgerEntry[]
  payments       Payment[]
  declines       OrderDecline[]
  refunds        Refund[]
  rating         OrderRating?
  misses         DriverMiss[]

  @@index([shiftDate, status])
  @@index([status, driverAcceptedAt, offeredAt])
}

// A customer's 1-5 star rating of a collected pickup, with an optional comment. One per order.
// The driver sees the stars and comment (never who wrote it); ops review low ratings.
model OrderRating {
  id         String    @id @default(uuid())
  orderId    String    @unique
  order      Order     @relation(fields: [orderId], references: [id])
  driverId   String
  driver     User      @relation("DriverRatings", fields: [driverId], references: [id])
  customerId String
  stars      Int
  comment    String?
  reviewedBy String?   // ops member who looked at a low rating
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([driverId, createdAt])
  @@index([stars, reviewedAt])
}

// A stop a driver didn't do: declined, let the accept time run out, or accepted but not collected by shift end.
// Kept for the driver's own history and analytics (OrderDecline rows are cleared when an order rolls over).
model DriverMiss {
  id        String    @id @default(uuid())
  driverId  String
  driver    User      @relation(fields: [driverId], references: [id])
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id])
  kind      String    // DECLINED | EXPIRED | NOT_COLLECTED
  reason    String?
  shiftDate DateTime? @db.Date
  createdAt DateTime  @default(now())

  @@index([driverId, createdAt])
}

// A driver turned down an assigned order. The order is not offered to that driver again.
model OrderDecline {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  driverId  String
  driver    User     @relation(fields: [driverId], references: [id])
  reason    String
  createdAt DateTime @default(now())

  @@unique([orderId, driverId])
  @@index([driverId])
}

model OrderEvidence {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  type         String   // "customer_placement" | "driver_pickup"
  photoUrl     String
  gpsLat       Float?
  gpsLng       Float?
  gpsAccuracy  Float?
  photoHash    String?  // SHA-256 of the photo file, to spot the same photo used for two orders
  capturedAt   DateTime
  aiAssessment Json?
  createdAt    DateTime @default(now())

  @@index([photoHash])
}

model FacilityVerification {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id])
  method     String   // "qr" | "pin"
  verifiedAt DateTime @default(now())
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  provider      String   // "paystack" | "hubtel"
  amount        Float
  status        String   // "success" | "failed" | "refunded"
  providerRef   String   @unique
  refundedAmount Float   @default(0) // money sent back to the customer from this payment
  createdAt     DateTime @default(now())
  refunds       Refund[]
}

model LedgerEntry {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  type        String   // "customer_payment" | "platform_fee" | "driver_payout_pickup" | "driver_payout_disposal" | "refund"
  amount      Float
  driverId    String?  // for driver payouts: the driver who earned it
  idempotencyKey String @unique
  amountPesewas Int?     // the same amount in whole pesewas (the source of truth for new money maths)
  clearsAt    DateTime?  // driver earnings: when they become withdrawable (null = waiting for the unload or ops)
  createdAt   DateTime @default(now())

  @@index([driverId])
  @@index([driverId, type])
}

model Dispute {
  id         String    @id @default(uuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id])
  raisedBy   String
  reason     String
  status     String    @default("OPEN")
  resolution String?
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  actorId   String?
  fromState String?
  toState   String
  reason    String?
  createdAt DateTime @default(now())
}
model Route {
  id        String      @id @default(uuid())
  driverId  String
  createdAt DateTime    @default(now())
  stops     RouteStop[]
  trips     RouteTrip[]
}

// One load of the night: the stops with this tripNumber, then unload at this disposal site.
model RouteTrip {
  id         String    @id @default(uuid())
  routeId    String
  route      Route     @relation(fields: [routeId], references: [id])
  tripNumber Int
  facilityId String?   // null when no suitable site was open; ops must choose one
  facility   Facility? @relation(fields: [facilityId], references: [id])
  createdAt  DateTime  @default(now())

  @@unique([routeId, tripNumber])
}

model RouteStop {
  id        String   @id @default(uuid())
  routeId   String
  route     Route    @relation(fields: [routeId], references: [id])
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  sequence  Int
  tripNumber Int     @default(1) // 1st, 2nd, 3rd load of the night; each trip ends at a disposal site
}

model RateLimitAttempt {
  id         String   @id @default(uuid())
  identifier String
  action     String
  success    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, action, createdAt])
}
model AdminActionLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  targetId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}

// Kinds of collection vehicle (aboboyaa, borla car, tipper truck). Capacity drives how many
// orders fit on one trip; the radius limits how far from a driver orders are offered.
model VehicleType {
  id              String   @id @default(uuid())
  code            String   @unique // "aboboyaa" | "borla-car" | "tipper-truck"
  name            String   // shown to drivers and ops, e.g. "Aboboyaa tricycle"
  capacityLitres  Int      // usable load space
  defaultRadiusKm Float    // radius a new driver of this type starts with
  maxRadiusKm     Float    // drivers can't set a radius above this
  imagePath       String?  // picture under /public, e.g. /vehicles/aboboyaa.svg
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  drivers         DriverProfile[]
}

// Messages for a user (e.g. "2 new stops for tonight"). Shown in the app and, if the phone allows it, sent as a push alert.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String
  url       String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, readAt])
}

// A phone or browser that agreed to receive push alerts for a user.
model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// Nightly jobs that must run once per night (plan ready, shift start, rollover). The key is the lock.
model JobRun {
  key     String   @id // e.g. "rollover:2026-09-29"
  ranAt   DateTime @default(now())
  summary String?
}

// A driver asks for their earnings to be sent to their mobile money wallet.
model Withdrawal {
  id            String    @id @default(uuid())
  driverId      String
  driver        User      @relation(fields: [driverId], references: [id])
  amount        Float
  status        String    @default("REQUESTED") // REQUESTED | PROCESSING | CONFIRMING | PAID | FAILED | REJECTED
  momoNumber    String
  momoProvider  String
  momoName      String
  reference     String    @unique // our transfer reference (also sent to Paystack)
  source        String    @default("request") // request (asked by the driver, sent by Finance) | cashout (Cash out now) | sweep (daily payout)
  feePesewas    Int       @default(0) // transfer fee the driver pays (extra cash-outs); the amount sent is amount minus this
  withholdingPesewas Int  @default(0) // tax withheld from this payout (lib/tax.ts); also taken from the amount sent
  transferCode  String?   // Paystack's transfer code
  method        String?   // "paystack" | "manual"
  note          String?   // reason for rejection/failure, or the manual payment reference
  markedPaidBy  String?   // manual payments: who recorded it (status CONFIRMING); a different person confirms it
  markedPaidAt  DateTime?
  reviewedBy    String?
  requestedAt   DateTime  @default(now())
  reviewedAt    DateTime?
  paidAt        DateTime?

  @@index([driverId, status])
  @@index([status])
}

// Money sent back to a customer for a payment (full or part).
model Refund {
  id              String    @id @default(uuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  paymentId       String
  payment         Payment   @relation(fields: [paymentId], references: [id])
  amount          Float
  reason          String
  status          String    @default("PENDING") // AWAITING_APPROVAL | PENDING | PROCESSING | PROCESSED | FAILED | NEEDS_ATTENTION
  paystackRefundId String?  @unique
  requestedBy     String    // user id (customer or staff)
  cancelOrder     Boolean   @default(false) // also cancel the order once the refund is sent
  approvedBy      String?   // large staff refunds: the second person who approved it
  approvedAt      DateTime?
  driverFault     Boolean   @default(false) // ops recorded the driver as at fault: their shares of the order are taken back
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
}

// Identity and vehicle documents a driver uploads for approval (private storage bucket).
model DriverDocument {
  id        String   @id @default(uuid())
  driverId  String
  driver    User     @relation(fields: [driverId], references: [id])
  type      String   // ghana_card | profile_photo | vehicle_photo | drivers_licence
  path      String   // path in the private driver-documents bucket
  createdAt DateTime @default(now())

  @@index([driverId, type])
}

// Double-entry ledger (lib/accounts.ts). Every money event is a journal whose postings add up to zero
// (the database refuses one that doesn't). Rows are never changed or deleted; mistakes get a correcting journal.
model Journal {
  id        String    @id @default(uuid())
  key       String    @unique // the event's idempotency key, so it is recorded once
  event     String    // payment | payment_fee | earned | fee_income | refund | payout | payout_reversed | top_up | settlement
  orderId   String?
  driverId  String?
  memo      String?
  createdBy String?   // staff member, for entries made by hand (top-ups, settlements)
  createdAt DateTime  @default(now())
  postings  Posting[]

  @@index([orderId])
  @@index([createdAt])
}

model Posting {
  id        String   @id @default(uuid())
  journalId String
  journal   Journal  @relation(fields: [journalId], references: [id])
  account   String   // lib/accounts.ts ACCOUNTS
  amount    Int      // pesewas: debit +, credit -
  orderId   String?  // per-order account (customer funds held)
  driverId  String?  // per-driver account (driver payable)
  createdAt DateTime @default(now())

  @@index([journalId])
  @@index([account, orderId])
  @@index([account, driverId])
}

// Paystack settlements to the bank, so Finance can confirm each one arrived (lib/reconcile-server.ts).
model PaystackSettlement {
  id              String    @id @default(uuid())
  paystackId      String    @unique
  settledAt       DateTime
  amountPesewas   Int       // what Paystack says it sent to the bank
  status          String    // Paystack's status, e.g. success | pending
  receivedPesewas Int?      // what Finance saw arrive
  confirmedBy     String?
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
}

// The morning check of the Paystack balance before the daily payout (lib/treasury.ts).
model TreasuryCheck {
  id             String   @id @default(uuid())
  day            String   @unique // YYYY-MM-DD, Accra
  drivers        Int      // drivers due a payout
  duePesewas     Int
  feesPesewas    Int
  bufferPesewas  Int
  balancePesewas Int?     // the Paystack balance at the time (null if Paystack didn't answer)
  topUpPesewas   Int      // what Finance needs to add
  createdAt      DateTime @default(now())
}

// The daily reconciliation against Paystack and the ledger (lib/reconcile.ts).
model ReconciliationRun {
  id         String    @id @default(uuid())
  day        String    @unique // the day checked, YYYY-MM-DD
  ok         Boolean
  results    Json
  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?
  createdAt  DateTime  @default(now())
}
